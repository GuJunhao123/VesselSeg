        try:
            # 寤惰繜瀵煎叆锛屽噺灏戝惎鍔ㄦ椂鐨勬ā鍧楀姞杞?            from quantitative_analysis import QuantitativeAnalyzer

            # 鏄剧ず鐘舵€佹爮鎻愮ず
            self.statusBar().showMessage("姝ｅ湪杩涜閲忓寲鍒嗘瀽...")

            # 鍒濆鍖栭噺鍖栧垎鏋愬櫒
            analyzer = QuantitativeAnalyzer()
            spacing = self.current_metadata['spacing'] if (
                self.current_metadata and 'spacing' in self.current_metadata
            ) else (1.0, 1.0, 1.0)

            # 鎻愬彇闂ㄩ潤鑴夊拰鑲濋潤鑴夋帺鐮?            portal_vein_mask = (self.current_label_data == 1)
            hepatic_vein_mask = (self.current_label_data == 2)
            vessel_union = portal_vein_mask | hepatic_vein_mask
            if not np.any(vessel_union):
                QMessageBox.warning(self, "鎻愮ず", "褰撳墠鏍囩涓湭妫€娴嬪埌PV/HV锛堟爣绛?/2锛夛紝璇峰厛瀹屾垚琛€绠″垎鍓层€?)
                self.statusBar().showMessage("閲忓寲鍒嗘瀽涓锛氱己灏戣绠℃爣绛?, 3000)
                return

            # 鑲濊剰鎺╃爜浼樺厛浣跨敤鏍囩3锛岃嫢涓嶅瓨鍦ㄥ垯鐢ㄨ绠¤啫鑳€杩戜技
            liver_mask = (self.current_label_data == 3)
            if not np.any(liver_mask):
                try:
                    from scipy import ndimage
                    if np.any(vessel_union):
                        liver_mask = ndimage.binary_dilation(vessel_union, iterations=20)
                    else:
                        liver_mask = np.ones_like(self.current_label_data, dtype=bool)
                except Exception:
                    liver_mask = np.ones_like(self.current_label_data, dtype=bool)

            # 鑲跨槫鎺╃爜锛氶粯璁ゆ爣绛?锛堝彲鎵╁睍锛?            tumor_mask = (self.current_label_data == 4)

            # 璁＄畻鑲濊剰鍒嗘
            segmentation = analyzer.couinaud_segmentation(
                liver_mask,
                portal_vein_mask,
                hepatic_vein_mask
