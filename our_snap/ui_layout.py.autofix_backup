        """纭繚鐙珛3D琛€绠℃爲绐楀彛瀛樺湪銆?""
        # 鐙珛绐楀彛涓庝富鐣岄潰3D绐楀彛淇濇寔鍚屾鍚庣涓庢樉绀烘晥鏋溿€?        force_matplotlib_3d = False
