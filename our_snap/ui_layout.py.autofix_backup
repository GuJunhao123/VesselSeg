                # 浣跨敤鏁版嵁搴撲腑鐨別ntry淇℃伅锛堜紭鍏堬級鏇存柊鐥呬汉鏄剧ず
                self._update_patient_info_from_entry(entry, metadata)

                QMessageBox.information(self, "鎴愬姛", f"鏁版嵁搴撳簭鍒楀姞杞芥垚鍔焅n{entry.display_name}\n灏哄: {data.shape}")
            else:
                QMessageBox.warning(self, "閿欒", "鏁版嵁搴撳簭鍒楀姞杞藉け璐?)
        except Exception as e:
            QMessageBox.critical(self, "閿欒", f"鍔犺浇鏁版嵁搴撳簭鍒楁椂鍙戠敓閿欒:\n{e}")

    def _update_patient_info_from_metadata(self, metadata: Optional[dict]):
        """鏍规嵁ImageIO杩斿洖鐨刴etadata涓殑dicom_info鏇存柊鐥呬汉淇℃伅"""
        info = {}
        if metadata and isinstance(metadata, dict):
            info = metadata.get("dicom_info") or {}

        # 濡傛灉dicom_info涓虹┖鎴栦俊鎭笉瀹屾暣锛屽皾璇曚粠褰撳墠鍥惧儚璺緞涓彁鍙栧熀鏈俊鎭?        if self.current_image_path:
            path_parts = os.path.normpath(self.current_image_path).split(os.sep)
            # 灏濊瘯浠庤矾寰勪腑鎻愬彇鎮ｈ€匢D锛堝鏋滆繕娌℃湁锛?            if not info.get("PatientID"):
                for part in reversed(path_parts):
                    # 鏇村鏉剧殑鍖归厤锛?-4浣嶆暟瀛楅兘鍙兘鏄偅鑰匢D
                    if part.isdigit() and 1 <= len(part) <= 4:
                        info["PatientID"] = part
                        break

            # 灏濊瘯浠庤矾寰勪腑鎻愬彇Series淇℃伅锛堝鏋滆繕娌℃湁锛?            if not info.get("SeriesDescription"):
                # 鏌ユ壘SE*鐩綍
                for part in reversed(path_parts):
                    if part.startswith("SE") and len(part) > 2:
                        # 妫€鏌E鍚庨潰鐨勯儴鍒嗘槸鍚︽槸鏁板瓧
                        suffix = part[2:]
                        if suffix.isdigit():
                            info["SeriesDescription"] = part
                            break
                        # 涔熸敮鎸丼E鍚庨潰娌℃湁鏁板瓧鐨勬儏鍐?                        elif not suffix:
                            info["SeriesDescription"] = part
                            break

            # 灏濊瘯浠庤矾寰勪腑鎻愬彇Study淇℃伅锛堝鏋滆繕娌℃湁锛?            if not info.get("StudyID"):
                # 鏌ユ壘ST*鐩綍
                for part in reversed(path_parts):
                    if part.startswith("ST") and len(part) > 2:
                        # 妫€鏌T鍚庨潰鐨勯儴鍒嗘槸鍚︽槸鏁板瓧
                        suffix = part[2:]
                        if suffix.isdigit():
                            info["StudyID"] = part
                            break
                        # 涔熸敮鎸丼T鍚庨潰娌℃湁鏁板瓧鐨勬儏鍐?                        elif not suffix:
                            info["StudyID"] = part
                            break

        # 纭繚鑷冲皯鏈変竴浜涗俊鎭鎻愬彇
        self._apply_patient_info(info)

    def _update_patient_info_from_entry(self, entry: SeriesEntry, metadata: Optional[dict]):
        """缁煎悎鏁版嵁搴揺ntry鍜宮etadata涓殑dicom_info鏇存柊鐥呬汉淇℃伅"""
        info = {}
        if metadata and isinstance(metadata, dict):
            info = metadata.get("dicom_info") or {}
            # 濡傛灉dicom_info鏄┖瀛楀吀锛岀‘淇漣nfo鏄瓧鍏歌€屼笉鏄疦one
            if not isinstance(info, dict):
                info = {}

        # 瑕嗙洊/琛ュ厖瀛楁锛屼互鏁版嵁搴撲腑鐨勪俊鎭负浼樺厛
        if entry:
            if entry.patient_id:
                info["PatientID"] = entry.patient_id
            if entry.patient_name:
                info["PatientName"] = entry.patient_name
            if entry.study_date:
                info["StudyDate"] = entry.study_date

        # 搴旂敤鐥呬汉淇℃伅
        self._apply_patient_info(info)


