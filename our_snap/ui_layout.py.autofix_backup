            self.btn_add_seed.setText("鉃?娣诲姞绉嶅瓙鐐?)
            self.btn_add_seed.setStyleSheet("")
            # 鏇存柊鐥呬汉淇℃伅鏄剧ず
            # 濡傛灉鏋勫缓浜唀ntry锛屼娇鐢╡ntry淇℃伅锛堟洿瀹屾暣锛夛紱鍚﹀垯鍙娇鐢╩etadata
