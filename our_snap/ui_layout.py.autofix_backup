    def _on_label_statistics(self):
        """鏍囩缁熻"""
        if self.current_label_data is None:
            QMessageBox.warning(self, "鎻愮ず", "璇峰厛鍔犺浇鎴栧垱寤烘爣绛?)
            return

        try:
            # 璁＄畻鎵€鏈夋爣绛剧殑缁熻淇℃伅
            unique_labels = np.unique(self.current_label_data)
            unique_labels = unique_labels[unique_labels > 0]  # 鎺掗櫎鑳屾櫙(0)

            if len(unique_labels) == 0:
                QMessageBox.information(self, "鎻愮ず", "褰撳墠娌℃湁鏍囩鏁版嵁")
                return

            stats_text = "鏍囩缁熻淇℃伅:\n\n"

            for label_id in unique_labels:
                label_mask = (self.current_label_data == label_id)
                voxel_count = np.sum(label_mask)

                # 璁＄畻鐗╃悊浣撶Н
                if self.current_metadata and 'spacing' in self.current_metadata:
                    spacing = self.current_metadata['spacing']
                    voxel_volume = spacing[0] * spacing[1] * spacing[2]  # mm鲁
                    volume_mm3 = voxel_count * voxel_volume
                    volume_cm3 = volume_mm3 / 1000.0  # cm鲁
                    volume_text = f"{volume_cm3:.2f} cm鲁 ({volume_mm3:.2f} mm鲁)"
                else:
                    volume_text = f"{voxel_count} 浣撶礌"

                # 璁＄畻琛ㄩ潰绉紙杩戜技锛?                from scipy import ndimage
                # 浣跨敤褰㈡€佸姊害璁＄畻琛ㄩ潰绉?                edges = ndimage.binary_dilation(label_mask) ^ label_mask
                surface_pixels = np.sum(edges)

                if self.current_metadata and 'spacing' in self.current_metadata:
                    spacing = self.current_metadata['spacing']
                    pixel_area = spacing[0] * spacing[1]  # mm虏
                    surface_area_mm2 = surface_pixels * pixel_area
                    surface_area_cm2 = surface_area_mm2 / 100.0  # cm虏
                    area_text = f"{surface_area_cm2:.2f} cm虏 ({surface_area_mm2:.2f} mm虏)"
                else:
                    area_text = f"{surface_pixels} 鍍忕礌"

                stats_text += f"鏍囩 {label_id}:\n"
                stats_text += f"  浣撶Н: {volume_text}\n"
                stats_text += f"  琛ㄩ潰绉? {area_text}\n"
                stats_text += f"  浣撶礌鏁? {voxel_count}\n\n"

            QMessageBox.information(self, "鏍囩缁熻", stats_text)
        except Exception as e:
            QMessageBox.critical(self, "閿欒", f"璁＄畻鏍囩缁熻鏃跺彂鐢熼敊璇?\n{e}")

