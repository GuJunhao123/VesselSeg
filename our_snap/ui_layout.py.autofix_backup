        btn_clear.clicked.connect(self._on_clear_label)
        top_bar.addWidget(btn_clear)

        btn_update_3d = QPushButton("鏇存柊3D")
        btn_update_3d.clicked.connect(self._on_update_3d)
        top_bar.addWidget(btn_update_3d)
