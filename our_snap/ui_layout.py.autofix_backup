            # 璁＄畻浣撶Н
            volumes = analyzer.calculate_volumes(segmentation, voxel_size=spacing)

            # 鎻愬彇琛€绠￠噺鍖栨寚鏍?            vascular_metrics = analyzer.extract_vascular_metrics(
                portal_vein_mask,
                hepatic_vein_mask,
