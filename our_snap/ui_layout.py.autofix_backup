    def _on_undo(self):
        """鎾ら攢鎿嶄綔"""
        if self.undo_history:
            # 淇濆瓨褰撳墠鐘舵€佸埌閲嶅仛鏍?            if self.current_label_data is not None:
                self.redo_history.append(np.copy(self.current_label_data))
                # 闄愬埗閲嶅仛鏍堝ぇ灏?                if len(self.redo_history) > self.max_history_size:
                    self.redo_history.pop(0)

            # 浠庢挙閿€鏍堟仮澶?            self.current_label_data = self.undo_history.pop()
            self.four_view.set_label_data(self.current_label_data)
            self._refresh_structure_from_current_labels()

    def _on_redo(self):
        """閲嶅仛鎿嶄綔"""
        if self.redo_history:
            # 淇濆瓨褰撳墠鐘舵€佸埌鎾ら攢鏍?            if self.current_label_data is not None:
                self.undo_history.append(np.copy(self.current_label_data))
                # 闄愬埗鎾ら攢鏍堝ぇ灏?                if len(self.undo_history) > self.max_history_size:
                    self.undo_history.pop(0)

            # 浠庨噸鍋氭爤鎭㈠
            self.current_label_data = self.redo_history.pop()
            self.four_view.set_label_data(self.current_label_data)
